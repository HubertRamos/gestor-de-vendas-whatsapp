                    className="w-full h-9 px-3 text-xs bg-white border border-[#E2E8F0] rounded-xl focus:outline-none focus:border-[#7C5CFF]"
                  />
                </div>
              </div>

              <div className="pt-3 border-t border-[#E2E8F0] flex justify-end space-x-2">
                <button
                  type="button"
                  onClick={() => setModalNewMerchandise(false)}
                  className="h-9 px-4 bg-white border border-[#E2E8F0] text-[#1E293B] text-xs font-bold rounded-xl"
                >
                  Cancelar
                </button>
                <button
                  type="submit"
                  className="h-9 px-4 bg-[#7C5CFF] text-white text-xs font-extrabold rounded-xl shadow-xs"
                >
                  Registrar Compra
                </button>
              </div>
            </form>
          </div>
        </div>
      )}

    </div>
  );
}