export default function App() {
  // --- LOCAL STORAGE INITIALIZATION ---
  const [periods, setPeriods] = useState(() => {
    const saved = localStorage.getItem('eventsales_periods');
    return saved ? JSON.parse(saved) : INITIAL_PERIODS;
  });

  const [activePeriodId, setActivePeriodId] = useState(() => {
    const saved = localStorage.getItem('eventsales_active_period');
    return saved ? saved : 'per_1';
  });

  const [products, setProducts] = useState(() => {
    const saved = localStorage.getItem('eventsales_products');
    return saved ? JSON.parse(saved) : INITIAL_PRODUCTS;
  });

  const [sales, setSales] = useState(() => {
    const saved = localStorage.getItem('eventsales_sales');
    return saved ? JSON.parse(saved) : INITIAL_SALES;
  });

  const [debtPayments, setDebtPayments] = useState(() => {
    const saved = localStorage.getItem('eventsales_debt_payments');
    return saved ? JSON.parse(saved) : INITIAL_DEBT_PAYMENTS;
  });

  const [expenses, setExpenses] = useState(() => {
    const saved = localStorage.getItem('eventsales_expenses');
    return saved ? JSON.parse(saved) : INITIAL_EXPENSES;
  });

  const [merchandise, setMerchandise] = useState(() => {
    const saved = localStorage.getItem('eventsales_merchandise');
    return saved ? JSON.parse(saved) : INITIAL_MERCHANDISE;
  });

  // Navigation & Layout State
  const [activeTab, setActiveTab] = useState('inicio');
  const [mobileMenuOpen, setMobileMenuOpen] = useState(false);

  // --- PERSISTENCE EFFECT ---
  useEffect(() => {
    localStorage.setItem('eventsales_periods', JSON.stringify(periods));
    localStorage.setItem('eventsales_active_period', activePeriodId);
    localStorage.setItem('eventsales_products', JSON.stringify(products));
    localStorage.setItem('eventsales_sales', JSON.stringify(sales));
    localStorage.setItem('eventsales_debt_payments', JSON.stringify(debtPayments));
    localStorage.setItem('eventsales_expenses', JSON.stringify(expenses));
    localStorage.setItem('eventsales_merchandise', JSON.stringify(merchandise));
  }, [periods, activePeriodId, products, sales, debtPayments, expenses, merchandise]);

  // Current Active Period
  const activePeriod = useMemo(() => {
    return periods.find(p => p.id === activePeriodId) || periods[0] || { name: 'Sem Período' };
  }, [periods, activePeriodId]);

  // --- FORM STATES & MODALS ---
  const [saleBuyer, setSaleBuyer] = useState('');
  const [cart, setCart] = useState([]);
  const [selectedProdId, setSelectedProdId] = useState('');
  const [selectedProdQty, setSelectedProdQty] = useState(1);
  const [salePaymentType, setSalePaymentType] = useState('A_VISTA');
  const [salePaidNow, setSalePaidNow] = useState('');
  const [salePaymentMethod, setSalePaymentMethod] = useState('PIX');

  // Modals
  const [modalNewPeriod, setModalNewPeriod] = useState(false);
  const [modalNewProduct, setModalNewProduct] = useState(false);
  const [modalEditProduct, setModalEditProduct] = useState(null);
  const [modalNewExpense, setModalNewExpense] = useState(false);
  const [modalNewMerchandise, setModalNewMerchandise] = useState(false);
  const [modalPayDebt, setModalPayDebt] = useState(null);

  // Filter States
  const [salesSearch, setSalesSearch] = useState('');
  const [productSearch, setProductSearch] = useState('');
  const [debtSearch, setDebtSearch] = useState('');
  const [financialSubTab, setFinancialSubTab] = useState('resumo');

  // Form Fields
  const [periodForm, setPeriodForm] = useState({ name: '', startDate: '', endDate: '', location: '' });
  const [productForm, setProductForm] = useState({ name: '', category: 'Bebidas', costPrice: '', defaultPrice: '' });
  const [expenseForm, setExpenseForm] = useState({ description: '', category: 'Infraestrutura', amount: '', date: '' });
  const [merchandiseForm, setMerchandiseForm] = useState({ supplier: '', description: '', amount: '', invoiceRef: '', hasInvoice: true, date: '' });
  const [debtPayForm, setDebtPayForm] = useState({ amount: '', paymentMethod: 'PIX' });

  // --- HELPER FORMATTERS ---
  const formatMoney = (val) => new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL' }).format(val || 0);
  const formatDate = (isoStr) => {
    if (!isoStr) return '-';
    const d = new Date(isoStr);
    return isNaN(d.getTime()) ? isoStr : d.toLocaleDateString('pt-BR') + ' ' + d.toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit' });
  };

  // --- FINANCIAL CALCULATIONS FOR CURRENT PERIOD ---
  const currentPeriodSales = useMemo(() => sales.filter(s => s.periodId === activePeriodId), [sales, activePeriodId]);
  const currentPeriodExpenses = useMemo(() => expenses.filter(e => e.periodId === activePeriodId), [expenses, activePeriodId]);
  const currentPeriodMerchandise = useMemo(() => merchandise.filter(m => m.periodId === activePeriodId), [merchandise, activePeriodId]);
  const currentPeriodDebtPayments = useMemo(() => debtPayments.filter(dp => dp.periodId === activePeriodId), [debtPayments, activePeriodId]);

  const metrics = useMemo(() => {
    const grossSalesTotal = currentPeriodSales.reduce((acc, s) => acc + s.totalAmount, 0);
    const directCashFromSales = currentPeriodSales.reduce((acc, s) => acc + (s.paidAmount || 0), 0);
    const debtCashReceivedThisPeriod = currentPeriodDebtPayments.reduce((acc, dp) => acc + dp.amount, 0);
    const totalCashReceived = directCashFromSales + debtCashReceivedThisPeriod;
    const periodPendingDebts = currentPeriodSales.reduce((acc, s) => acc + (s.pendingAmount || 0), 0);
    const totalExpenses = currentPeriodExpenses.reduce((acc, e) => acc + e.amount, 0);
    const totalMerchandiseCost = currentPeriodMerchandise.reduce((acc, m) => acc + m.amount, 0);
    const netCashResult = totalCashReceived - (totalExpenses + totalMerchandiseCost);

    return {
      grossSalesTotal,
      totalCashReceived,
      directCashFromSales,
      debtCashReceivedThisPeriod,
      periodPendingDebts,
      totalExpenses,
      totalMerchandiseCost,
      netCashResult
    };
  }, [currentPeriodSales, currentPeriodExpenses, currentPeriodMerchandise, currentPeriodDebtPayments]);

  // --- GLOBAL DEBT AGGREGATION ---
  const buyersWithDebt = useMemo(() => {
    const debtMap = {};
    sales.forEach(s => {
      if (s.pendingAmount > 0) {
        if (!debtMap[s.buyerName]) {
          debtMap[s.buyerName] = {
            buyerName: s.buyerName,
            totalPending: 0,
            salesList: []
          };
        }
        debtMap[s.buyerName].totalPending += s.pendingAmount;
        debtMap[s.buyerName].salesList.push(s);
      }
    });
    return Object.values(debtMap);
  }, [sales]);

  const totalGlobalPendingDebts = useMemo(() => {
    return buyersWithDebt.reduce((acc, b) => acc + b.totalPending, 0);
  }, [buyersWithDebt]);

  // --- CART & SALE ACTIONS ---
  const handleAddToCart = () => {
    if (!selectedProdId) return;
    const prod = products.find(p => p.id === selectedProdId);
    if (!prod) return;

    const existingIndex = cart.findIndex(c => c.productId === selectedProdId);
    if (existingIndex >= 0) {
      const updated = [...cart];
      updated[existingIndex].qty += Number(selectedProdQty);
      setCart(updated);
    } else {
      setCart([...cart, {
        productId: prod.id,
        name: prod.name,
        qty: Number(selectedProdQty),
        unitPrice: prod.defaultPrice
      }]);
    }
    setSelectedProdQty(1);
  };

  const handleRemoveFromCart = (index) => {
    setCart(cart.filter((_, i) => i !== index));
  };

  const handleUpdateCartPrice = (index, newPrice) => {
    const updated = [...cart];
    updated[index].unitPrice = parseFloat(newPrice) || 0;
    setCart(updated);
  };

  const cartTotal = useMemo(() => {
    return cart.reduce((acc, item) => acc + (item.qty * item.unitPrice), 0);
  }, [cart]);

  const handleRegisterSale = (e) => {
    e.preventDefault();
    if (!saleBuyer.trim()) {
      alert('Por favor, informe o nome do comprador.');
      return;
    }
    if (cart.length === 0) {
      alert('Adicione ao menos um produto ao carrinho.');
      return;
    }

    let paid = 0;
    let pending = 0;
    let status = 'Pago';

    if (salePaymentType === 'A_VISTA') {
      paid = cartTotal;
      pending = 0;
      status = 'Pago';
    } else if (salePaymentType === 'FIADO') {
      paid = 0;
      pending = cartTotal;
      status = 'Fiado';
    } else if (salePaymentType === 'PARCIAL') {
      const paidInput = parseFloat(salePaidNow) || 0;
      if (paidInput >= cartTotal) {
        paid = cartTotal;
        pending = 0;
        status = 'Pago';
      } else {
        paid = paidInput;
        pending = cartTotal - paidInput;
        status = 'Parcial';
      }
    }

    const newSale = {
      id: `VND-${Math.floor(1000 + Math.random() * 9000)}`,
      periodId: activePeriodId,
      buyerName: saleBuyer.trim(),
      items: cart,
      totalAmount: cartTotal,
      paidAmount: paid,
      pendingAmount: pending,
      paymentMethod: salePaymentType === 'FIADO' ? 'Fiado' : salePaymentMethod,
      status: status,
      createdAt: new Date().toISOString()
    };

    setSales([newSale, ...sales]);
    setSaleBuyer('');
    setCart([]);
    setSalePaymentType('A_VISTA');
    setSalePaidNow('');
  };

  // --- DEBT PAYMENT ACTION ---
  const handlePayDebtSubmit = (e) => {
    e.preventDefault();
    if (!modalPayDebt) return;

    const payAmount = parseFloat(debtPayForm.amount);
    if (!payAmount || payAmount <= 0) {
      alert('Informe um valor válido para pagamento.');
      return;
    }

    const buyerName = modalPayDebt.buyerName;
    let remainingToPay = payAmount;
    const updatedSales = [...sales];
    const newPayments = [];

    for (let i = 0; i < updatedSales.length; i++) {
      if (remainingToPay <= 0) break;

      const sale = updatedSales[i];
      if (sale.buyerName === buyerName && sale.pendingAmount > 0) {
        const paymentForThisSale = Math.min(sale.pendingAmount, remainingToPay);

        sale.pendingAmount -= paymentForThisSale;
        sale.paidAmount += paymentForThisSale;
        sale.status = sale.pendingAmount === 0 ? 'Pago' : 'Parcial';

        remainingToPay -= paymentForThisSale;

        newPayments.push({
          id: `PAY-${Math.floor(1000 + Math.random() * 9000)}`,
          saleId: sale.id,
          buyerName: buyerName,
          amount: paymentForThisSale,
          periodId: activePeriodId,
          paymentMethod: debtPayForm.paymentMethod,
          createdAt: new Date().toISOString()
        });
      }
    }

    setSales(updatedSales);
    setDebtPayments([...newPayments, ...debtPayments]);
    setModalPayDebt(null);
    setDebtPayForm({ amount: '', paymentMethod: 'PIX' });
  };

  // --- ENTITY HANDLERS ---
  const handleCreatePeriod = (e) => {
    e.preventDefault();
    if (!periodForm.name) return;

    const newP = {
      id: `per_${Date.now()}`,
      name: periodForm.name,
      status: 'Ativo',
      startDate: periodForm.startDate || new Date().toISOString().split('T')[0],
      endDate: periodForm.endDate || '-',
      location: periodForm.location || 'Não informada'
    };

    setPeriods([newP, ...periods]);
    setActivePeriodId(newP.id);
    setPeriodForm({ name: '', startDate: '', endDate: '', location: '' });
    setModalNewPeriod(false);
  };

  const handleCreateProduct = (e) => {
    e.preventDefault();
    if (!productForm.name) return;

    const newProd = {
      id: `prod_${Date.now()}`,
      name: productForm.name,
      category: productForm.category,
      costPrice: parseFloat(productForm.costPrice) || 0,
      defaultPrice: parseFloat(productForm.defaultPrice) || 0
    };

    setProducts([...products, newProd]);
    setProductForm({ name: '', category: 'Bebidas', costPrice: '', defaultPrice: '' });
    setModalNewProduct(false);
  };

  const handleSaveEditedProduct = (e) => {
    e.preventDefault();
    if (!modalEditProduct) return;
    setProducts(products.map(p => p.id === modalEditProduct.id ? modalEditProduct : p));
    setModalEditProduct(null);
  };

  const handleCreateExpense = (e) => {
    e.preventDefault();
    if (!expenseForm.description || !expenseForm.amount) return;

    const newExp = {
      id: `EXP-${Math.floor(100 + Math.random() * 900)}`,
      periodId: activePeriodId,
      description: expenseForm.description,
      category: expenseForm.category,
      amount: parseFloat(expenseForm.amount),
      date: expenseForm.date || new Date().toISOString().split('T')[0]
    };

    setExpenses([newExp, ...expenses]);
    setExpenseForm({ description: '', category: 'Infraestrutura', amount: '', date: '' });
    setModalNewExpense(false);
  };

  const handleCreateMerchandise = (e) => {
    e.preventDefault();
    if (!merchandiseForm.description || !merchandiseForm.amount) return;

    const newMerch = {
      id: `MER-${Math.floor(100 + Math.random() * 900)}`,
      periodId: activePeriodId,
      supplier: merchandiseForm.supplier || 'Fornecedor Diversos',
      description: merchandiseForm.description,
      amount: parseFloat(merchandiseForm.amount),
      invoiceRef: merchandiseForm.invoiceRef || 'S/N',
      hasInvoice: merchandiseForm.hasInvoice,
      date: merchandiseForm.date || new Date().toISOString().split('T')[0]
    };

    setMerchandise([newMerch, ...merchandise]);
    setMerchandiseForm({ supplier: '', description: '', amount: '', invoiceRef: '', hasInvoice: true, date: '' });
    setModalNewMerchandise(false);
  };

  // Nav items configuration
  const navItems = [
    { id: 'inicio', label: 'Painel Geral', icon: LayoutDashboard },
    { id: 'vendas', label: 'Vendas & Caixa', icon: ShoppingCart },
    { id: 'financeiro', label: 'Financeiro', icon: Wallet },
    { id: 'periodos', label: 'Períodos & Torneios', icon: Calendar },
    { id: 'produtos', label: 'Produtos', icon: Package }
  ];

  return (
    <div className="min-h-screen bg-[#F4F6FB] text-[#1E293B] font-sans flex flex-col md:flex-row antialiased">

      {/* MOBILE TOP HEADER */}
      <header className="md:hidden bg-white border-b border-[#E2E8F0] px-4 py-3 flex items-center justify-between sticky top-0 z-30 shadow-xs">
        <div className="flex items-center space-x-2.5">
          <div className="w-8 h-8 bg-[#7C5CFF] rounded-lg flex items-center justify-center text-white font-bold text-sm shadow-xs">
            ES
          </div>
          <span className="font-bold text-[#1E293B] text-base tracking-tight">EventSales</span>
        </div>
        <button
          onClick={() => setMobileMenuOpen(!mobileMenuOpen)}
          className="p-2 rounded-lg text-[#71809D] hover:bg-[#F4F6FB] transition-colors"
          aria-label="Abrir Menu"
        >
          {mobileMenuOpen ? <X size={20} /> : <Menu size={20} />}
        </button>
      </header>

      {/* SIDEBAR (POLOCOIN AESTHETIC - WHITE, ROUNDED SELECTIONS, USER BADGE AT TOP) */}
      <aside
        className={`fixed md:sticky top-0 left-0 z-40 h-screen w-64 bg-white border-r border-[#E2E8F0] flex flex-col justify-between transition-transform duration-200 ease-in-out ${
          mobileMenuOpen ? 'translate-x-0' : '-translate-x-full md:translate-x-0'
        }`}
      >
        <div>
          {/* POLOCOIN PROFILE HEADER AT SIDEBAR TOP */}
          <div className="p-5 border-b border-[#E2E8F0] flex flex-col items-center text-center space-y-2">
            <div className="relative">
              <div className="w-14 h-14 rounded-full bg-[#7C5CFF]/10 border-2 border-[#7C5CFF] flex items-center justify-center text-[#7C5CFF] font-black text-lg shadow-sm">
                <ShieldCheck size={28} />
              </div>
              <span className="absolute bottom-0 right-0 w-3.5 h-3.5 bg-[#16B981] border-2 border-white rounded-full" />
            </div>
            <div>
              <h3 className="font-bold text-sm text-[#1E293B]">adm</h3>
              <p className="text-[11px] font-medium text-[#71809D]">Gestão de Eventos</p>
            </div>
          </div>

          {/* NAV LINKS WITH POLOCOIN STYLING */}
          <nav className="p-4 space-y-1.5">
            {navItems.map((item) => {
              const Icon = item.icon;
              const isActive = activeTab === item.id;
              return (
                <button
                  key={item.id}
                  onClick={() => {
                    setActiveTab(item.id);
                    setMobileMenuOpen(false);
                  }}
                  className={`w-full flex items-center space-x-3 px-3.5 py-3 rounded-xl text-xs font-bold transition-all ${
                    isActive
                      ? 'bg-[#7C5CFF] text-white shadow-sm'
                      : 'text-[#71809D] hover:bg-[#F4F6FB] hover:text-[#1E293B]'
                  }`}
                >
                  <Icon size={18} className={isActive ? 'text-white' : 'text-[#71809D]'} />
                  <span>{item.label}</span>
                </button>
              );
            })}
          </nav>
        </div>

        {/* ACTIVE PERIOD SELECTOR AT SIDEBAR BOTTOM */}
        <div className="p-4 border-t border-[#E2E8F0] bg-white space-y-3">
          <div className="p-3 bg-[#F4F6FB] rounded-xl border border-[#E2E8F0] space-y-1.5">
            <div className="flex items-center justify-between">
              <span className="text-[10px] font-bold text-[#71809D] uppercase tracking-wider">Período Ativo</span>
              <span className={`text-[9px] font-extrabold px-1.5 py-0.5 rounded ${
                activePeriod.status === 'Ativo' ? 'bg-[#16B981]/15 text-[#16B981]' : 'bg-[#71809D]/15 text-[#71809D]'
              }`}>
                {activePeriod.status}
              </span>
            </div>
            <select
              value={activePeriodId}
              onChange={(e) => setActivePeriodId(e.target.value)}
              className="w-full text-xs font-semibold text-[#1E293B] bg-white border border-[#E2E8F0] rounded-lg px-2.5 py-1.5 focus:outline-none focus:border-[#7C5CFF]"
            >
              {periods.map((p) => (
                <option key={p.id} value={p.id}>
                  {p.name}
                </option>
              ))}
            </select>
          </div>
        </div>
      </aside>

      {/* MOBILE BACKDROP */}
      {mobileMenuOpen && (
        <div
          onClick={() => setMobileMenuOpen(false)}
          className="fixed inset-0 bg-black/20 z-30 md:hidden backdrop-blur-xs"
        />
